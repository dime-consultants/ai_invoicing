APP_NAME=Guardian
APP_ENV=stage
LOG_LEVEL=INFO

# Email delivery. Development defaults to console email output when DEBUG=True.
DEFAULT_FROM_EMAIL=Guardian <no-reply@dimeconsultants.africa>
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5
STAGE_FIXED_OTP_CODE=00000
